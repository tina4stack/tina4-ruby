# Environment & secrets
.env
/.env.local
.env.local
.keys/

# Logs & sessions
logs/
sessions/

# Queue storage — data/queue is the canonical store; .queue is the legacy one
# the lite backend migrates out of on first use, and may still appear locally.
data/queue/
.queue/

# Database files
*.db
*.sqlite3

# Ruby / Bundler
vendor/
.bundle/
Gemfile.lock

# Temp & build
tmp/
tmp_preview.rb
*.gem
pkg/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test artifacts
coverage/
spec/integration/

# Benchmark
benchmark/
*.gem
.tina4/

# macOS $TMPDIR leak guard: a spec mis-resolving an absolute tmp path relative
# to cwd would create these under the repo. Never commit them.
/var/folders/

# rspec JSON summary written by the zero-dependency CI leg (.github/workflows/test.yml)
zero-dep-results.json

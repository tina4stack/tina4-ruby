# Environment & secrets
.env
/.env.local
.env.local
.keys/

# Logs & sessions
logs/
sessions/

# Runtime file-backend storage (all machine-written): queue, cache, sessions,
# mailbox, rt_storage, docstore. Ignore data/ wholesale to match nodejs — nothing
# under data/ is tracked in this repo. .queue is the legacy store the lite queue
# backend migrates out of on first use.
data/
.queue/

# Database files
*.db
*.sqlite3

# Ruby / Bundler
vendor/
.bundle/
Gemfile.lock

# Temp & build
tmp/
tmp_preview.rb
*.gem
pkg/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test artifacts
coverage/
spec/integration/

# Benchmark
benchmark/
*.gem
.tina4/

# macOS $TMPDIR leak guard: a spec mis-resolving an absolute tmp path relative
# to cwd would create these under the repo. Never commit them.
/var/folders/

# rspec JSON summary written by the zero-dependency CI leg (.github/workflows/test.yml)
zero-dep-results.json
